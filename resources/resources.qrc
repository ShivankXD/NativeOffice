<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/assets">
       <!-- Existing small banner badge (used by Impress). Aliased to the
            renamed file so existing :/assets/logo.jpg references keep working. -->
       <file alias="logo.jpg">logo_dark_sheet.png</file>
       <!-- New full NativeOffice brand logo, used on the startup splash. -->
       <file alias="nativeoffice-logo.png">logo_light_bg.png</file>
       <!-- Transparent brand mark (RGBA), used for the sidebar logo lockup
            and as the source for the Windows app icon. -->
       <file alias="nativeoffice-logo-mark.png">logo_white_bg.png</file>
       <!-- The Windows app icon, multi-resolution (16 through 256). Also set
            as the QApplication window icon so every window and dialog picks
            the right size, instead of Windows falling back to squashing one
            frame of the .exe icon. -->
       <file alias="app.ico">nativeoffice.ico</file>
       <!-- Tick glyph for QCheckBox::indicator:checked. A stylesheet-styled
            indicator draws no mark of its own, so without this a checked box
            is an indistinguishable filled square. Regenerate with
            resources/make_check_icon.py. -->
       <file alias="check-white.png">check-white.png</file>
       <file alias="check-white@2x.png">check-white@2x.png</file>
       <!-- Spin-box chevrons. A styled ::up-arrow needs a real image; the CSS
            zero-size-plus-borders triangle trick paints an empty block in Qt. -->
       <file alias="spin-up.png">spin-up.png</file>
       <file alias="spin-up@2x.png">spin-up@2x.png</file>
       <file alias="spin-down.png">spin-down.png</file>
       <file alias="spin-down@2x.png">spin-down@2x.png</file>
       <!-- The same problem on the dark Home tool pages, where the spin
            artwork above (dark, for the light chrome) is invisible.
            Regenerate with resources/make_chevron_icon.py. -->
       <file alias="chevron-down-light.png">chevron-down-light.png</file>
       <file alias="chevron-down-light@2x.png">chevron-down-light@2x.png</file>
       <!-- Stasis brand mark for the AI sidebar and the Use AI button. The
            source art is a white glyph on a large black field; these are the
            glyph alone on transparency, cropped to its bounding box.
            Regenerate with resources/make_stasis_mark.py. -->
       <file alias="stasis-mark.png">stasis-mark.png</file>
       <file alias="stasis-mark-32.png">stasis-mark-32.png</file>
       <file alias="stasis-mark-64.png">stasis-mark-64.png</file>
       <file alias="stasis-mark-256.png">stasis-mark-256.png</file>
       <!-- Home hero banner art, one per time of day. The greeting sits over
            the LEFT half, so each band is cropped (and morning mirrored) to
            keep its bright area on the right. Regenerate from the full-size
            source with scratchpad/make_strips.py. -->
       <file alias="hero-morning.jpg">hero-morning.jpg</file>
       <file alias="hero-afternoon.jpg">hero-afternoon.jpg</file>
       <file alias="hero-evening.jpg">hero-evening.jpg</file>
       <file alias="hero-night.jpg">hero-night.jpg</file>
       <!-- Create-card art, composited from the supplied 3D renders by
            scratchpad/make_cards.py: subject high in the frame, lower third
            left clear for the name the card draws over it. -->
       <file alias="card-document.jpg">card-document.jpg</file>
       <file alias="card-spreadsheet.jpg">card-spreadsheet.jpg</file>
       <file alias="card-presentation.jpg">card-presentation.jpg</file>
       <file alias="card-pdf.jpg">card-pdf.jpg</file>
    </qresource>
</RCC>
